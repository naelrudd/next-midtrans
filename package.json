{
  "name": "next-midtrans-monorepo",
  "private": true,
  "description": "Typed Midtrans integration for Next.js App Router",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w next-midtrans",
